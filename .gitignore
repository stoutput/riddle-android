# Build outputs. Releases are produced by .github/workflows/release.yml and
# attached to a GitHub Release, so no APK belongs in the history.
build/
*.apk
*.idsig

# Signing material must never be committed. CI supplies the release key from
# repository secrets; a local build generates a throwaway key here.
keystore/
*.jks
*.keystore

# Rust
riddle-core/target/

# The cross-compiled engine. build-native.sh creates this directory and writes
# the .so into it, so the binary is a build product, not a source file — it is
# 2.5 MB that would change on every commit.
android/app/jniLibs/

# Generated by `cargo run --example dump_page`
dumped-*.png

# JetBrains / VS Code / macOS
.idea/
.vscode/
.DS_Store
